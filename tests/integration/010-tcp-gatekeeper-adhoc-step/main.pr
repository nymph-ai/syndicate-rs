# The file adhoc-step.pr introduces a new kind of stepType, <adhoc LABEL>.
# Here, we try it out.

let ?ds = dataspace
<debug-dataspace $ds "remote-object">

let ?s = <relay-listener <tcp "127.0.0.1" 9001> $gatekeeper>
<require-service $s>

<bind <adhoc foo> $ds #f>

? <service-state $s ready> [
  let ?r = <route [<tcp "127.0.0.1" 9001>] <adhoc foo>>
  <q <resolve-path $r>>
  ? <a <resolve-path $r> <ok <resolved-path _ _ ?session>>> [
    $session += ping
  ]
]

$ds ? ping [ $config += <pass> ]
