# TCP listener sharing a dataspace with a gatekeeper and a sturdyref but no noise

let ?ds = dataspace
<debug-dataspace $ds "remote-object">

let ?s = <relay-listener <tcp "127.0.0.1" 9001> $gatekeeper>
<require-service $s>

<bind <adhoc foo> $ds #f>

# ? <q <resolve-path-step ?origin <adhoc ?adhoc>>> [
#   let ?k = dataspace
#   $config <debug-dataspace $k "K">
#   $origin += <resolve <adhoc $adhoc> $k>
# ]

? <service-state $s ready> [
  let ?r = <route [<tcp "127.0.0.1" 9001>] <adhoc foo>>
  <q <resolve-path $r>>
  ? <a <resolve-path $r> <ok <resolved-path _ _ ?session>>> [
    $session += ping
  ]
]

$ds ? ping [ $config += <pass> ]
